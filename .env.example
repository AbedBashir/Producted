# Copy this file to `.env` for local development, or set these as
# environment variables in your Hostinger Node.js app (hPanel > Websites >
# your domain > Advanced > Node.js).

# --- Shopify app credentials (Partner Dashboard > Apps > Producted) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_products,write_metaobjects,write_metaobject_definitions

# Public URL of this deployment. Must match `application_url` in
# shopify.app.toml and the domain Shopify redirects to after OAuth.
SHOPIFY_APP_URL=https://producted.invitationsbash.com

# --- Database (MySQL, e.g. Hostinger's included MySQL database) ---
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
DATABASE_URL=

# Port the Node.js server listens on. Hostinger's Node.js app manager sets
# this automatically — only set it manually for local/manual runs.
PORT=3000
